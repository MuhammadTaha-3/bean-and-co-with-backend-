# MongoDB connection string (server-only: never exposed to the browser)
MONGODB_URI=mongodb://127.0.0.1:27017/bean-and-co
# The one email allowed into /admin (email-only login, no password)
ADMIN_EMAIL=admin@beanandco.pk
# Random string (32+ chars) used to sign the admin session cookie
AUTH_SECRET=change-me-to-a-long-random-string
